# Channel Service Configuration
PORT=4001
NODE_ENV=development

# CRM Callback Configuration
CRM_CALLBACK_URL=http://localhost:4000/api/callbacks/channel-event

# Simulation Timing Controls (milliseconds)
# Delays are inter-stage gaps: time between consecutive event decisions
SIM_SENT_DELAY=500
SIM_DELIVERED_DELAY=1000
SIM_FAILED_DELAY=1500
SIM_OPENED_DELAY=1500
SIM_READ_DELAY=500
SIM_CLICKED_DELAY=1000
SIM_PURCHASED_DELAY=1500

# Per-channel stage probabilities (0.0 to 1.0)
# Each stage gate uses Math.random() < probability to decide if the event fires.
# If the probability check fails, the communication stops at that stage.
# Format: CHANNEL_SIM_<CHANNEL>_<STAGE>
# Examples:
# CHANNEL_SIM_WHATSAPP_DELIVERY=0.94
# CHANNEL_SIM_WHATSAPP_OPEN=0.75
# CHANNEL_SIM_WHATSAPP_READ=0.80
# CHANNEL_SIM_WHATSAPP_CLICK=0.28
# CHANNEL_SIM_WHATSAPP_PURCHASE=0.10
# CHANNEL_SIM_EMAIL_DELIVERY=0.90
# CHANNEL_SIM_EMAIL_OPEN=0.48
# CHANNEL_SIM_EMAIL_READ=0.60
# CHANNEL_SIM_EMAIL_CLICK=0.14
# CHANNEL_SIM_EMAIL_PURCHASE=0.03
# CHANNEL_SIM_SMS_DELIVERY=0.96
# CHANNEL_SIM_SMS_OPEN=0.52
# CHANNEL_SIM_SMS_READ=0.70
# CHANNEL_SIM_SMS_CLICK=0.18
# CHANNEL_SIM_SMS_PURCHASE=0.05
# If not set, the built-in per-channel defaults above are used.

# Retry Configuration for Callback Failures
CALLBACK_RETRY_ATTEMPTS=3
CALLBACK_RETRY_DELAY_MS=1000
