# Server Settings
PORT=4000
NODE_ENV=development

# Database Settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthpilot?schema=public"

# Channel Service (external)
CHANNEL_SERVICE_URL=http://localhost:4001

# ──────────────────────────────────────────────
# AI Provider Configuration
# ──────────────────────────────────────────────
# Supported providers: mock, github, gemini
AI_PROVIDER=mock

# GitHub Models (used when AI_PROVIDER=github)
# Available models: openai/gpt-4o-mini, deepseek/deepseek-r1, meta-llama/Llama-3.3-70B-Instruct, etc.
# Use the {publisher}/{model} format from the catalog at https://models.github.ai/catalog/models
AI_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_API_KEY=
# Endpoint URL (default: https://models.github.ai/inference/chat/completions)
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions
# Enable JSON mode (default: true). Set to false for models that do not support response_format.
# GITHUB_MODELS_JSON_MODE=true

# Gemini (used when AI_PROVIDER=gemini)
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash, etc.
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
